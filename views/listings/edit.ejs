<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h3>Edit your listing : <%= listing.title%></h3>
     <form method="post" action="/listings/<%=listing._id%>?_method=PUT">
        <textarea name = "listing[title]" type="text"><%=listing.title%></textarea>
        <br><br>
        <textarea name = "listing[description]" type="text"><%=listing.description%></textarea>
        <br><br>
        <textarea name = "listing[image]" type="text"><%=listing.image%></textarea>
        <br><br>
        <textarea name = "listing[price]" type="number"><%=listing.price%></textarea>
        <br><br>
        <textarea name = "listing[location]" type="text"><%=listing.location%></textarea>
        <br><br>
        <textarea name = "listing[country]" type="text"><%=listing.country%></textarea>
        <br><br>
        <button>Update</button>
    </form>
</body>
</html>